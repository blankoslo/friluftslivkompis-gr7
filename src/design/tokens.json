{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Lars Monsen Design System",
    "description": "Fargepalett inspirert av norsk villmark, ild og natur",
    "version": "1.0.0",
    "themes": ["light", "dark"]
  },

  "brand": {
    "flame-primary": {
      "$type": "color",
      "$value": { "light": "#C8602A", "dark": "#E8702F" },
      "$description": "Primærknapper, CTA — Bålflame"
    },
    "flame-hover": {
      "$type": "color",
      "$value": { "light": "#A04A1E", "dark": "#C8602A" },
      "$description": "Hover-tilstand — Emberglød"
    },
    "flame-pressed": {
      "$type": "color",
      "$value": { "light": "#7A3515", "dark": "#A04A1E" },
      "$description": "Pressed/aktiv tilstand — Rustbrun"
    },
    "flame-tint": {
      "$type": "color",
      "$value": { "light": "#FAEADE", "dark": "#3A2410" },
      "$description": "Tinted bakgrunn, tags — Gløresten"
    }
  },

  "neutral": {
    "bg": {
      "$type": "color",
      "$value": { "light": "#FAF7F2", "dark": "#1A1612" },
      "$description": "Primær sidebakgrunn — Bjørkehvit / Nattmørket"
    },
    "surface": {
      "$type": "color",
      "$value": { "light": "#F0EBE0", "dark": "#2A2118" },
      "$description": "Kortbakgrunn, flater — Lynghei / Lavvubrunt"
    },
    "border": {
      "$type": "color",
      "$value": { "light": "#D6CCBF", "dark": "#4A3E34" },
      "$description": "Kanter og separatorer — Elveleire / Trestamme"
    },
    "text-primary": {
      "$type": "color",
      "$value": { "light": "#2A211A", "dark": "#F0EBE3" },
      "$description": "Primær tekst — Skogbunn / Bjørkesnø"
    },
    "text-muted": {
      "$type": "color",
      "$value": { "light": "#7A6F63", "dark": "#7A6F63" },
      "$description": "Sekundær tekst, labels — Reinlav (lik i begge moduser)"
    },
    "text-disabled": {
      "$type": "color",
      "$value": { "light": "#D6CCBF", "dark": "#4A3E34" },
      "$description": "Deaktivert tekst"
    }
  },

  "accent": {
    "forest": {
      "$type": "color",
      "$value": { "light": "#3D5E35", "dark": "#4A6741" },
      "$description": "Suksess, natur-aksent — Granskog"
    },
    "forest-tint": {
      "$type": "color",
      "$value": { "light": "#E8F0E6", "dark": "#1E2E1C" },
      "$description": "Tinted natur-bakgrunn"
    },
    "fjord": {
      "$type": "color",
      "$value": { "light": "#3D6475", "dark": "#5A7A8A" },
      "$description": "Info, linker — Fjordblå"
    },
    "fjord-tint": {
      "$type": "color",
      "$value": { "light": "#E0ECF0", "dark": "#1A2830" },
      "$description": "Tinted fjord-bakgrunn"
    },
    "midnight-sun": {
      "$type": "color",
      "$value": { "light": "#B8891E", "dark": "#D4A853" },
      "$description": "Varsel, highlight — Midnattsol"
    },
    "midnight-sun-tint": {
      "$type": "color",
      "$value": { "light": "#FBF3DC", "dark": "#2E2810" },
      "$description": "Tinted midnattsol-bakgrunn"
    }
  },

  "semantic": {
    "success": {
      "$type": "color",
      "$value": { "light": "#3D5E35", "dark": "#4A6741" },
      "$description": "Suksess-tilstand"
    },
    "info": {
      "$type": "color",
      "$value": { "light": "#3D6475", "dark": "#5A7A8A" },
      "$description": "Informasjons-tilstand"
    },
    "warning": {
      "$type": "color",
      "$value": { "light": "#A04A1E", "dark": "#E8702F" },
      "$description": "Advarsel-tilstand"
    },
    "warning-bg": {
      "$type": "color",
      "$value": { "light": "#FAEADE", "dark": "#2A1A10" },
      "$description": "Advarsel bakgrunn"
    },
    "warning-border": {
      "$type": "color",
      "$value": { "light": "#E8702F", "dark": "#A04A1E" },
      "$description": "Advarsel kant"
    }
  },

  "button": {
    "primary-bg": {
      "$type": "color",
      "$value": { "light": "#C8602A", "dark": "#C8602A" },
      "$description": "Primærknapp bakgrunn"
    },
    "primary-bg-hover": {
      "$type": "color",
      "$value": { "light": "#A04A1E", "dark": "#A04A1E" },
      "$description": "Primærknapp hover"
    },
    "primary-text": {
      "$type": "color",
      "$value": { "light": "#FFFFFF", "dark": "#FFFFFF" },
      "$description": "Primærknapp tekst"
    },
    "secondary-border": {
      "$type": "color",
      "$value": { "light": "#C8602A", "dark": "#C8602A" },
      "$description": "Sekundærknapp kant"
    },
    "secondary-text": {
      "$type": "color",
      "$value": { "light": "#C8602A", "dark": "#C8602A" },
      "$description": "Sekundærknapp tekst"
    },
    "ghost-border": {
      "$type": "color",
      "$value": { "light": "#D6CCBF", "dark": "#4A3E34" },
      "$description": "Ghost-knapp kant"
    },
    "ghost-text": {
      "$type": "color",
      "$value": { "light": "#7A6F63", "dark": "#7A6F63" },
      "$description": "Ghost-knapp tekst"
    }
  },

  "typography": {
    "font-heading": {
      "$type": "fontFamily",
      "$value": "Georgia, 'Playfair Display', serif",
      "$description": "Overskriftsfont — robust og klassisk"
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": "'Source Sans Pro', Inter, sans-serif",
      "$description": "Brødtekstfont — lesbar og solid"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "'Courier New', monospace",
      "$description": "Monospace — koder og hex-verdier"
    },
    "size-h1": { "$type": "dimension", "$value": "32px" },
    "size-h2": { "$type": "dimension", "$value": "24px" },
    "size-h3": { "$type": "dimension", "$value": "20px" },
    "size-body": { "$type": "dimension", "$value": "16px" },
    "size-small": { "$type": "dimension", "$value": "12px" },
    "letter-spacing-wide": {
      "$type": "dimension",
      "$value": "0.12em",
      "$description": "Brukes på labels og tags"
    }
  },

  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" }
  },

  "border-radius": {
    "sm": { "$type": "dimension", "$value": "3px" },
    "md": { "$type": "dimension", "$value": "5px" },
    "lg": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "12px" }
  }
}
